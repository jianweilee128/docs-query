# Copy to .env and fill in. Never commit .env.

# Embeddings (Chroma still uses OpenAI by default)
OPENAI_API_KEY=

# Optional. Defaults to text-embedding-3-small
# EMBED_MODEL=text-embedding-3-small

# --- Chat / judge ---
# Leave LLM_BASE_URL empty to use OpenAI with CHAT_MODEL below.
# For Ollama, set the base URL (the /v1 suffix is required) and a local model
# name that matches `ollama list`.
#
# LLM_BASE_URL=http://localhost:11434/v1
# CHAT_MODEL=qwen3
# JUDGE_MODEL=qwen3

CHAT_MODEL=gpt-4.1-mini
JUDGE_MODEL=gpt-4.1-mini
